# Flask Configuration
FLASK_APP=wsgi.py
FLASK_ENV=production
SECRET_KEY=generate-strong-random-secret-key-here-use-secrets-token-urlsafe-50

# Database Configuration
DATABASE_URL=postgresql://qrcode_user:SECURE_PASSWORD@db:5432/qrcode_db
DB_PASSWORD=SECURE_PASSWORD
DB_POOL_SIZE=10
DB_POOL_RECYCLE=3600

# Redis Configuration (for caching and rate limiting)
REDIS_URL=redis://:SECURE_REDIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=SECURE_REDIS_PASSWORD
CACHE_TIMEOUT=300

# Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Session Configuration
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Strict
PERMANENT_SESSION_LIFETIME=3600

# Security Configuration
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=900

# Rate Limiting
RATELIMIT_ENABLED=True
RATELIMIT_DEFAULT=100 per hour
RATELIMIT_LOGIN=5 per minute
RATELIMIT_API=60 per minute

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# Monitoring (Optional - Sentry)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Health Check
HEALTH_CHECK_ENABLED=True

# Application Settings
APP_NAME=IBQ QR Code Generator
APP_VERSION=2.0.0
ITEMS_PER_PAGE=12
